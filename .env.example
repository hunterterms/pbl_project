# Sign in with Google / Apple (Amazon Cognito).
# Copy this file to .env.local and fill it in with the outputs of the CloudFormation stack (see infra/README.md).
# None of these are secret: they end up in the JavaScript that browsers download.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=

# Which sign-in buttons to show: google, apple, or google,apple. Only list providers that are set up in Cognito.
VITE_AUTH_PROVIDERS=google,apple
